import { createTool } from "@mastra/core/tools";
import { z } from "zod";

import {
  existsSync,
  readFileSync,
} from "node:fs";

import {
  gunzipSync,
} from "node:zlib";

import {
  getSoftOneObjectRegistryEntry,
  normalizeSoftOneObjectName,
} from "../softone/registry";

type SchemaField = {
  name?: string;
  caption?: string;
  type?: string;
  editor?: string;
  defaultvalue?: string;
  required?: boolean;
  readOnly?: boolean;
  calculated?: boolean;
};

type SchemaTable = {
  name?: string;
  dbname?: string;
  caption?: string;
  fields?: SchemaField[];
};

type SchemaObject = {
  type?: string;
  caption?: string;
  tables?: SchemaTable[];
};

type SchemaRoot =
  Record<string, SchemaObject>;

type Relation = {
  sourceObject: string;
  sourceTable: string;
  sourceField: string;
  caption: string;
  targetObject: string;
  relationType: string;
};

let schemaCache:
  SchemaRoot | null = null;

let relationsCache:
  Relation[] | null = null;

function normalize(
  value: string,
): string {
  return value
    .normalize("NFD")
    .replace(
      /[\u0300-\u036f]/g,
      "",
    )
    .trim()
    .toUpperCase()
    .replace(/\s+/g, " ");
}

function loadSchema(): SchemaRoot {
  if (schemaCache) {
    return schemaCache;
  }

  const path =
    process.env.SOFTONE_SCHEMA_PATH ??
    "data/softone-full-schema.json.gz";

  if (!existsSync(path)) {
    throw new Error(
      `SoftOne schema cache not found: ${path}`,
    );
  }

  const parsed =
    JSON.parse(
      gunzipSync(
        readFileSync(path),
      ).toString("utf8"),
    ) as unknown;

  if (
    !parsed ||
    typeof parsed !== "object" ||
    Array.isArray(parsed)
  ) {
    throw new Error(
      "SoftOne schema root must be an object",
    );
  }

  schemaCache =
    parsed as SchemaRoot;

  return schemaCache;
}

function loadRelations(): Relation[] {
  if (relationsCache) {
    return relationsCache;
  }

  const path =
    process.env.SOFTONE_RELATIONS_PATH ??
    "data/softone-full-relations.json";

  if (!existsSync(path)) {
    throw new Error(
      `SoftOne relations cache not found: ${path}`,
    );
  }

  const parsed =
    JSON.parse(
      readFileSync(
        path,
        "utf8",
      ),
    ) as unknown;

  if (!Array.isArray(parsed)) {
    throw new Error(
      "SoftOne relations cache must be an array",
    );
  }

  relationsCache = parsed
    .map(value => {
      if (
        !Array.isArray(value) ||
        value.length < 6
      ) {
        return null;
      }

      const [
        sourceObject,
        sourceTable,
        sourceField,
        caption,
        targetObject,
        relationType,
      ] = value;

      if (
        typeof sourceObject !== "string" ||
        typeof sourceTable !== "string" ||
        typeof sourceField !== "string" ||
        typeof caption !== "string" ||
        typeof targetObject !== "string" ||
        typeof relationType !== "string"
      ) {
        return null;
      }

      return {
        sourceObject,
        sourceTable,
        sourceField,
        caption,
        targetObject,
        relationType,
      };
    })
    .filter(
      (
        value,
      ): value is Relation =>
        value !== null,
    );

  return relationsCache;
}

function resolveObject(
  query: string,
  schema: SchemaRoot,
): string | null {
  const canonical =
    normalizeSoftOneObjectName(
      query,
    );

  if (schema[canonical]) {
    return canonical;
  }

  const q = normalize(query);

  for (
    const [object, metadata] of
    Object.entries(schema)
  ) {
    if (
      normalize(object) === q
    ) {
      return object;
    }

    if (
      metadata.caption &&
      normalize(
        metadata.caption,
      ) === q
    ) {
      return object;
    }

    const registry =
      getSoftOneObjectRegistryEntry(
        object,
      );

    if (
      registry?.aliases?.some(
        alias =>
          normalize(alias) === q,
      )
    ) {
      return object;
    }
  }

  return null;
}

function relationForField(
  relations: Relation[],
  object: string,
  table: string,
  field: string,
) {
  return relations.filter(
    relation =>
      normalize(
        relation.sourceObject,
      ) === normalize(object) &&
      normalize(
        relation.sourceTable,
      ) === normalize(table) &&
      normalize(
        relation.sourceField,
      ) === normalize(field),
  );
}

function classifyField(
  field: SchemaField,
  relationMatches: Relation[],
) {
  const editor =
    field.editor?.trim() ?? "";

  const serverManaged =
    field.readOnly === true ||
    field.calculated === true ||
    field.type === "AutoInc";

  if (serverManaged) {
    return {
      classification:
        "SERVER_MANAGED" as const,

      serverManaged: true,

      requiresResolution: false,
    };
  }

  if (
    editor.toUpperCase().startsWith(
      "XCMD:",
    )
  ) {
    return {
      classification:
        "COMMAND_EDITOR" as const,

      serverManaged: false,

      requiresResolution: true,
    };
  }

  if (editor.startsWith("$")) {
    return {
      classification:
        "INTERNAL_EDITOR" as const,

      serverManaged: false,

      requiresResolution: true,
    };
  }

  if (
    relationMatches.length > 0
  ) {
    return {
      classification:
        "OBJECT_REFERENCE" as const,

      serverManaged: false,

      requiresResolution: true,
    };
  }

  /*
   * Any remaining non-empty editor is significant SoftOne
   * metadata. Do not downgrade it to SCALAR merely because
   * RELATIONS_CACHE has no matching tuple.
   *
   * Examples:
   *   RELCOMPANY
   *   BRANCH
   *   FISCPRD
   *
   * The exact target may still be unverified, but the value
   * should be treated conservatively as requiring resolution.
   */
  if (editor) {
    return {
      classification:
        "REFERENCE_CANDIDATE" as const,

      serverManaged: false,

      requiresResolution: true,
    };
  }

  return {
    classification:
      "SCALAR" as const,

    serverManaged: false,

    requiresResolution: false,
  };
}

export const softonePayloadPlan =
  createTool({
    id: "softone-payload-plan",

    description: `
Creates a SAFE implementation plan for a SoftOne write payload.

This tool NEVER executes setData or any other write.

It validates proposed master-table values against cached SoftOne
schema and relations and identifies:

- accepted scalar values
- server-managed fields
- object references requiring tenant validation
- internal SoftOne editors requiring validation
- command/editor fields
- unknown fields
- missing schema-required input candidates
- payload readiness

It does NOT claim to know the minimum successful setData payload.
`,

    inputSchema: z.object({
      object: z
        .string()
        .min(1),

      intent: z
        .enum([
          "create",
          "update",
        ]),

      values: z
        .record(
          z.string(),
          z.unknown(),
        ),

      includeSchemaDefaults: z
        .boolean()
        .optional()
        .default(false),
    }),

    execute: async ({
      object,
      intent,
      values,
      includeSchemaDefaults,
    }) => {
      const schema =
        loadSchema();

      const relations =
        loadRelations();

      const resolvedObject =
        resolveObject(
          object,
          schema,
        );

      if (!resolvedObject) {
        return {
          status:
            "OBJECT_UNRESOLVED",

          writePerformed: false,

          object,

          instruction:
            "Do not construct a SoftOne payload because the object could not be resolved.",
        };
      }

      const schemaObject =
        schema[resolvedObject];

      const masterTable =
        schemaObject.tables?.[0];

      if (!masterTable) {
        return {
          status:
            "SCHEMA_UNAVAILABLE",

          writePerformed: false,

          object:
            resolvedObject,
        };
      }

      const masterTableName =
        masterTable.name ??
        masterTable.dbname ??
        "";

      const fields =
        masterTable.fields ?? [];

      const fieldMap =
        new Map(
          fields
            .filter(
              field =>
                typeof field.name ===
                "string",
            )
            .map(field => [
              normalize(
                field.name!,
              ),
              field,
            ]),
        );

      const acceptedScalars:
        Record<
          string,
          unknown
        > = {};

      const unresolvedReferences:
        Array<Record<string, unknown>> =
        [];

      const unresolvedInternalEditors:
        Array<Record<string, unknown>> =
        [];

      const commandEditors:
        Array<Record<string, unknown>> =
        [];

      const serverManagedFields:
        Array<Record<string, unknown>> =
        [];

      const unknownFields:
        Array<Record<string, unknown>> =
        [];

      const proposedValues:
        Record<
          string,
          unknown
        > = {};

      for (
        const [
          requestedField,
          value,
        ] of Object.entries(values)
      ) {
        const field =
          fieldMap.get(
            normalize(
              requestedField,
            ),
          );

        if (!field?.name) {
          unknownFields.push({
            field:
              requestedField,

            value,

            status:
              "UNKNOWN_FIELD",
          });

          continue;
        }

        const relationMatches =
          relationForField(
            relations,
            resolvedObject,
            masterTableName,
            field.name,
          );

        const classification =
          classifyField(
            field,
            relationMatches,
          );

        if (
          classification
            .classification ===
          "SERVER_MANAGED"
        ) {
          serverManagedFields.push({
            field:
              field.name,

            value,

            reason:
              field.type ===
              "AutoInc"
                ? "AUTOINC"
                : field.calculated
                  ? "CALCULATED"
                  : "READ_ONLY",

            action:
              "EXCLUDE_FROM_NORMAL_WRITE_INPUT",
          });

          continue;
        }

        if (
          classification
            .classification ===
          "OBJECT_REFERENCE"
        ) {
          const targets =
            Array.from(
              new Set(
                relationMatches.map(
                  relation =>
                    relation.targetObject,
                ),
              ),
            );

          unresolvedReferences.push({
            field:
              field.name,

            value,

            editor:
              field.editor ??
              null,

            targetObject:
              targets.length === 1
                ? targets[0]
                : null,

            relationTargets:
              targets,

            status:
              "PROVIDED_BUT_TENANT_UNVERIFIED",
          });

          proposedValues[
            field.name
          ] = value;

          continue;
        }

        if (
          classification
            .classification ===
          "REFERENCE_CANDIDATE"
        ) {
          unresolvedReferences.push({
            field:
              field.name,

            value,

            editor:
              field.editor ??
              null,

            targetObject:
              null,

            relationTargets:
              [],

            status:
              "REFERENCE_TARGET_UNVERIFIED",
          });

          proposedValues[
            field.name
          ] = value;

          continue;
        }

        if (
          classification
            .classification ===
          "INTERNAL_EDITOR"
        ) {
          unresolvedInternalEditors.push({
            field:
              field.name,

            value,

            editor:
              field.editor ??
              null,

            status:
              "VALUE_NOT_VALIDATED",
          });

          proposedValues[
            field.name
          ] = value;

          continue;
        }

        if (
          classification
            .classification ===
          "COMMAND_EDITOR"
        ) {
          commandEditors.push({
            field:
              field.name,

            value,

            editor:
              field.editor ??
              null,

            status:
              "BEHAVIOR_UNVERIFIED",
          });

          continue;
        }

        acceptedScalars[
          field.name
        ] = value;

        proposedValues[
          field.name
        ] = value;
      }

      const requiredInputCandidates =
        fields.filter(
          field =>
            field.name &&
            field.required === true &&
            field.readOnly !== true &&
            field.calculated !== true &&
            field.type !==
              "AutoInc",
        );

      const providedFieldNames =
        new Set(
          Object.keys(values).map(
            normalize,
          ),
        );

      const missingRequiredCandidates =
        intent === "create"
          ? requiredInputCandidates
              .filter(field => {
                if (!field.name) {
                  return false;
                }

                return !providedFieldNames.has(
                  normalize(field.name),
                );
              })
              .map(field => {
                const relationMatches =
                  relationForField(
                    relations,
                    resolvedObject,
                    masterTableName,
                    field.name!,
                  );

                const classification =
                  classifyField(
                    field,
                    relationMatches,
                  );

                const relationTargets =
                  Array.from(
                    new Set(
                      relationMatches.map(
                        relation =>
                          relation.targetObject,
                      ),
                    ),
                  );

                return {
                  field:
                    field.name,

                  caption:
                    field.caption ??
                    null,

                  editor:
                    field.editor ??
                    null,

                  schemaDefault:
                    field.defaultvalue ??
                    null,

                  classification:
                    classification.classification,

                  relationTargets,

                  targetObject:
                    relationTargets.length === 1
                      ? relationTargets[0]
                      : null,

                  hasSchemaDefault:
                    typeof field.defaultvalue ===
                      "string" &&
                    field.defaultvalue.length > 0,

                  status:
                    "SCHEMA_REQUIRED_NOT_PROVIDED",

                  note:
                    field.defaultvalue
                      ? "Schema default exists, but it is not automatically trusted as an executable write value."
                      : "No schema default is present.",
                };
              })
          : [];

      const missingRequiredNoDefault =
        missingRequiredCandidates.filter(
          candidate =>
            candidate.hasSchemaDefault ===
            false,
        );

      const defaultBackedRequiredCandidates =
        missingRequiredCandidates.filter(
          candidate =>
            candidate.hasSchemaDefault ===
            true,
        );

      const suggestedDefaults =
        includeSchemaDefaults
          ? requiredInputCandidates
              .filter(
                field =>
                  field.name &&
                  !providedFieldNames.has(
                    normalize(
                      field.name,
                    ),
                  ) &&
                  typeof
                    field.defaultvalue ===
                    "string" &&
                  field.defaultvalue
                    .length > 0,
              )
              .map(field => ({
                field:
                  field.name,

                value:
                  field.defaultvalue,

                status:
                  "SCHEMA_DEFAULT_ONLY",

                executable:
                  false,
              }))
          : [];

      const blockers = [
        ...unknownFields.map(
          item => ({
            type:
              "UNKNOWN_FIELD",
            field:
              item.field,
          }),
        ),

        ...unresolvedReferences.map(
          item => ({
            type:
              "UNVERIFIED_REFERENCE",
            field:
              item.field,
          }),
        ),

        ...unresolvedInternalEditors.map(
          item => ({
            type:
              "UNVALIDATED_INTERNAL_EDITOR",
            field:
              item.field,
          }),
        ),

        ...commandEditors.map(
          item => ({
            type:
              "COMMAND_EDITOR",
            field:
              item.field,
          }),
        ),
      ];

      /*
       * Minimum successful setData requirements are not yet
       * verified independently of the schema.
       *
       * Therefore this remains a blocker even when the caller
       * happens to provide every schema-required field.
       */
      blockers.push({
        type:
          "MINIMUM_PAYLOAD_UNVERIFIED",
        field: null,
      });

      for (
        const candidate of
        missingRequiredNoDefault
      ) {
        blockers.push({
          type:
            "REQUIRED_VALUE_UNRESOLVED",
          field:
            candidate.field,
        });
      }

      const status =
        blockers.length === 0
          ? "STRUCTURALLY_PLANNED"
          : "NOT_READY";

      const registry =
        getSoftOneObjectRegistryEntry(
          resolvedObject,
        );

      return {
        status,

        writePerformed: false,

        executablePayloadReady:
          false,

        intent,

        identity: {
          object:
            resolvedObject,

          schemaMasterTable:
            masterTable.name ??
            null,

          physicalMasterTable:
            registry
              ?.physicalMasterTable ??
            masterTable.dbname ??
            null,

          primaryKey:
            registry?.primaryKey ??
            null,
        },

        proposedValues,

        acceptedScalars,

        unresolvedReferences,

        unresolvedInternalEditors,

        commandEditors,

        serverManagedFields,

        unknownFields,

        missingRequiredCandidates,

        missingRequiredNoDefault,

        defaultBackedRequiredCandidates,

        suggestedDefaults,

        blockers,

        payloadSkeleton: {
          object:
            resolvedObject,

          data:
            proposedValues,
        },

        readiness: {
          structuralSchemaValidation:
            unknownFields.length ===
            0
              ? "PASS"
              : "FAIL",

          referenceValidation:
            unresolvedReferences.length ===
            0
              ? "PASS"
              : "REQUIRED",

          internalEditorValidation:
            unresolvedInternalEditors.length ===
            0
              ? "PASS"
              : "REQUIRED",

          commandEditorValidation:
            commandEditors.length ===
            0
              ? "PASS"
              : "REQUIRED",

          minimumSuccessfulSetDataPayload:
            "UNVERIFIED",

          tenantSpecificValues:
            unresolvedReferences.length ===
            0
              ? "NO_UNRESOLVED_OBJECT_REFERENCES"
              : "UNRESOLVED",

          writeApproval:
            "NOT_REQUESTED",

          finalWriteReadiness:
            "NOT_READY",
        },

        provenance: {
          object:
            "REGISTRY/SCHEMA_CACHE",

          fields:
            "SCHEMA_CACHE",

          relations:
            "RELATIONS_CACHE",

          suppliedValues:
            "USER_OR_CALLER_INPUT",

          defaults:
            includeSchemaDefaults
              ? "SCHEMA_CACHE"
              : null,
        },

        developerInstruction:
          "This is an implementation plan, not an executable or approved SoftOne write payload.",
      };
    },
  });
