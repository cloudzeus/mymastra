import { createTool } from "@mastra/core/tools";
import { z } from "zod";

import {
  existsSync,
  readFileSync,
} from "node:fs";

import {
  gunzipSync,
} from "node:zlib";

import {
  getSoftOneObjectRegistryEntry,
  normalizeSoftOneObjectName,
} from "../softone/registry";

type SchemaField = {
  name?: string;
  caption?: string;
  type?: string;
  editor?: string;
  defaultvalue?: string;
  required?: boolean;
  readOnly?: boolean;
  calculated?: boolean;
  fk?: string;
};

type SchemaTable = {
  name?: string;
  dbname?: string;
  caption?: string;
  fields?: SchemaField[];
};

type SchemaObject = {
  type?: string;
  caption?: string;
  tables?: SchemaTable[];
};

type SchemaRoot = Record<string, SchemaObject>;

type NormalizedRelation = {
  sourceObject: string;
  sourceTable: string;
  sourceField: string;
  caption: string;
  targetObject: string;
  relationType: string;
};

let schemaCache: SchemaRoot | null = null;
let relationsCache: NormalizedRelation[] | null = null;

function normalizeText(value: string): string {
  return value
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .trim()
    .toUpperCase()
    .replace(/\s+/g, " ");
}

function loadSchema(): SchemaRoot {
  if (schemaCache) {
    return schemaCache;
  }

  const path =
    process.env.SOFTONE_SCHEMA_PATH ??
    "data/softone-full-schema.json.gz";

  if (!existsSync(path)) {
    throw new Error(
      `SoftOne schema cache not found at ${path}`,
    );
  }

  const json = gunzipSync(
    readFileSync(path),
  ).toString("utf8");

  const parsed = JSON.parse(json) as unknown;

  if (
    !parsed ||
    typeof parsed !== "object" ||
    Array.isArray(parsed)
  ) {
    throw new Error(
      "SoftOne schema root must be an object",
    );
  }

  schemaCache = parsed as SchemaRoot;

  return schemaCache;
}

function loadRelations(): NormalizedRelation[] {
  if (relationsCache) {
    return relationsCache;
  }

  const path =
    process.env.SOFTONE_RELATIONS_PATH ??
    "data/softone-full-relations.json";

  if (!existsSync(path)) {
    throw new Error(
      `SoftOne relations cache not found at ${path}`,
    );
  }

  const parsed = JSON.parse(
    readFileSync(path, "utf8"),
  ) as unknown;

  if (!Array.isArray(parsed)) {
    throw new Error(
      "SoftOne relations cache must be an array",
    );
  }

  relationsCache = parsed
    .map(value => {
      if (
        !Array.isArray(value) ||
        value.length < 6
      ) {
        return null;
      }

      const [
        sourceObject,
        sourceTable,
        sourceField,
        caption,
        targetObject,
        relationType,
      ] = value;

      if (
        typeof sourceObject !== "string" ||
        typeof sourceTable !== "string" ||
        typeof sourceField !== "string" ||
        typeof caption !== "string" ||
        typeof targetObject !== "string" ||
        typeof relationType !== "string"
      ) {
        return null;
      }

      return {
        sourceObject,
        sourceTable,
        sourceField,
        caption,
        targetObject,
        relationType,
      };
    })
    .filter(
      (
        value,
      ): value is NormalizedRelation =>
        value !== null,
    );

  return relationsCache;
}

function resolveSchemaObject(
  query: string,
  schema: SchemaRoot,
): string | null {
  const canonical =
    normalizeSoftOneObjectName(query);

  if (schema[canonical]) {
    return canonical;
  }

  const normalizedQuery =
    normalizeText(query);

  for (
    const [object, schemaObject] of
    Object.entries(schema)
  ) {
    if (
      normalizeText(object) ===
      normalizedQuery
    ) {
      return object;
    }

    if (
      schemaObject.caption &&
      normalizeText(
        schemaObject.caption,
      ) === normalizedQuery
    ) {
      return object;
    }

    const registry =
      getSoftOneObjectRegistryEntry(
        object,
      );

    if (
      registry?.aliases?.some(
        alias =>
          normalizeText(alias) ===
          normalizedQuery,
      )
    ) {
      return object;
    }
  }

  return null;
}

function findField(
  schemaObject: SchemaObject,
  fieldQuery: string,
) {
  const normalizedField =
    normalizeText(fieldQuery);

  for (
    const [
      tableIndex,
      table,
    ] of (
      schemaObject.tables ?? []
    ).entries()
  ) {
    for (
      const field of
      table.fields ?? []
    ) {
      if (
        field.name &&
        normalizeText(field.name) ===
          normalizedField
      ) {
        return {
          tableIndex,
          table,
          field,
        };
      }
    }
  }

  return null;
}

function editorMatchesObject(
  editor: string,
  schema: SchemaRoot,
): string | null {
  const normalized =
    normalizeText(editor);

  if (schema[normalized]) {
    return normalized;
  }

  for (const object of Object.keys(schema)) {
    if (
      normalizeText(object) ===
      normalized
    ) {
      return object;
    }
  }

  return null;
}

export const softoneReferenceResolver =
  createTool({
    id: "softone-reference-resolver",

    description: `
Resolves the technical behavior of a SoftOne field.

It determines whether a field is:

- SCALAR
- INTERNAL_EDITOR
- OBJECT_REFERENCE
- COMMAND_EDITOR

It also reports:
- schema editor
- relation target
- relation type
- whether tenant-specific resolution is required
- whether the field appears server-managed
- provenance and verification status

Use this before generating implementation logic or SoftOne payloads.
`,

    inputSchema: z.object({
      object: z
        .string()
        .min(1),

      field: z
        .string()
        .min(1),

      table: z
        .string()
        .min(1)
        .optional(),
    }),

    execute: async ({
      object,
      field,
      table,
    }) => {
      const schema =
        loadSchema();

      const relations =
        loadRelations();

      const resolvedObject =
        resolveSchemaObject(
          object,
          schema,
        );

      if (!resolvedObject) {
        return {
          found: false,
          object,
          field,
          error:
            "SoftOne object could not be resolved from cached schema/registry.",
          status: "OBJECT_UNRESOLVED",
        };
      }

      const schemaObject =
        schema[resolvedObject];

      if (!schemaObject) {
        return {
          found: false,
          object:
            resolvedObject,
          field,
          error:
            "Resolved SoftOne object is missing from cached schema.",
        };
      }

      const fieldResult =
        findField(
          schemaObject,
          field,
        );

      if (!fieldResult) {
        return {
          found: false,
          object:
            resolvedObject,
          field,
          error:
            "Field was not found in the cached object schema.",
          status: "FIELD_UNRESOLVED",
        };
      }

      const {
        tableIndex,
        table: schemaTable,
        field: schemaField,
      } = fieldResult;

      if (
        table &&
        normalizeText(
          table,
        ) !==
          normalizeText(
            schemaTable.name ??
              schemaTable.dbname ??
              "",
          )
      ) {
        return {
          found: false,
          object:
            resolvedObject,
          field:
            schemaField.name ??
            field,
          requestedTable:
            table,
          actualTable:
            schemaTable.name ??
            null,
          error:
            "Field exists, but not in the requested table.",
          status:
            "TABLE_FIELD_MISMATCH",
        };
      }

      const editor =
        schemaField.editor?.trim() ??
        "";

      const sourceTable =
        schemaTable.name ??
        schemaTable.dbname ??
        "";

      const relationMatches =
        relations.filter(
          relation =>
            normalizeText(
              relation.sourceObject,
            ) ===
              normalizeText(
                resolvedObject,
              ) &&
            normalizeText(
              relation.sourceTable,
            ) ===
              normalizeText(
                sourceTable,
              ) &&
            normalizeText(
              relation.sourceField,
            ) ===
              normalizeText(
                schemaField.name ??
                  field,
              ),
        );

      const relationTargets =
        Array.from(
          new Set(
            relationMatches.map(
              relation =>
                relation.targetObject,
            ),
          ),
        );

      let classification:
        | "SCALAR"
        | "INTERNAL_EDITOR"
        | "OBJECT_REFERENCE"
        | "COMMAND_EDITOR";

      let targetObject:
        string | null = null;

      let verification:
        | "VERIFIED"
        | "PARTIALLY_VERIFIED"
        | "SCHEMA_ONLY";

      if (
        editor.toUpperCase().startsWith(
          "XCMD:",
        )
      ) {
        classification =
          "COMMAND_EDITOR";

        verification =
          "VERIFIED";
      } else if (
        editor.startsWith("$")
      ) {
        classification =
          "INTERNAL_EDITOR";

        verification =
          "VERIFIED";
      } else if (
        relationMatches.length > 0
      ) {
        classification =
          "OBJECT_REFERENCE";

        targetObject =
          relationTargets.length === 1
            ? relationTargets[0]
            : null;

        verification =
          "VERIFIED";
      } else if (editor) {
        const editorTarget =
          editorMatchesObject(
            editor,
            schema,
          );

        if (editorTarget) {
          classification =
            "OBJECT_REFERENCE";

          targetObject =
            editorTarget;

          verification =
            "PARTIALLY_VERIFIED";
        } else {
          /*
           * Non-empty editor exists, but we cannot prove
           * that it maps to a business object.
           *
           * Treat it conservatively as a command/editor
           * mechanism rather than inventing a target.
           */
          classification =
            "COMMAND_EDITOR";

          verification =
            "SCHEMA_ONLY";
        }
      } else {
        classification =
          "SCALAR";

        verification =
          "VERIFIED";
      }

      const serverManaged =
        schemaField.readOnly ===
          true ||
        schemaField.calculated ===
          true ||
        schemaField.type ===
          "AutoInc";

      const tenantValueRequired =
        classification ===
          "OBJECT_REFERENCE" &&
        !serverManaged;

      const executableValueReady =
        !tenantValueRequired &&
        classification !==
          "COMMAND_EDITOR";

      return {
        found: true,

        object:
          resolvedObject,

        table: {
          name:
            schemaTable.name ??
            null,

          dbname:
            schemaTable.dbname ??
            null,

          isMasterTable:
            tableIndex === 0,
        },

        field: {
          name:
            schemaField.name ??
            field,

          caption:
            schemaField.caption ??
            null,

          type:
            schemaField.type ??
            null,

          required:
            schemaField.required ===
            true,

          readOnly:
            schemaField.readOnly ===
            true,

          calculated:
            schemaField.calculated ===
            true,

          defaultValue:
            schemaField.defaultvalue ??
            null,

          editor:
            editor || null,

          schemaFk:
            schemaField.fk &&
            schemaField.fk.trim()
              ? schemaField.fk
              : null,
        },

        resolution: {
          classification,

          targetObject,

          relationTargets,

          relationTypes:
            Array.from(
              new Set(
                relationMatches.map(
                  relation =>
                    relation.relationType,
                ),
              ),
            ),

          tenantValueRequired,

          serverManaged,

          executableValueReady,

          verification,
        },

        relationEvidence:
          relationMatches,

        provenance: {
          object:
            "SCHEMA_CACHE/REGISTRY",

          field:
            "SCHEMA_CACHE",

          editor:
            "SCHEMA_CACHE",

          relations:
            relationMatches.length > 0
              ? "RELATIONS_CACHE"
              : null,

          targetObject:
            relationMatches.length > 0
              ? "RELATIONS_CACHE"
              : targetObject
                ? "SCHEMA_CACHE"
                : "UNVERIFIED",
        },

        developerInstruction:
          serverManaged
            ? "Do not treat this field as a normal explicit write input unless verified otherwise."
            : tenantValueRequired
              ? "Resolve the tenant-specific target value before generating an executable payload."
              : classification ===
                    "COMMAND_EDITOR"
                ? "Do not infer executable behavior from the editor string. Additional verification is required."
                : "Field can be treated as a normal scalar/internal-editor input subject to SoftOne business rules.",
      };
    },
  });
