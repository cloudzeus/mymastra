export type SoftOneObjectRegistryEntry = {
  object: string;
  description?: string;

  /**
   * Table name exposed by the SoftOne object/Web Services schema.
   */
  webServiceMasterTable?: string;

  /**
   * Actual physical SQL master table, only when explicitly known.
   * Never infer this from the object name.
   */
  physicalMasterTable?: string;

  primaryKey?: string;

  aliases?: string[];

  notes?: string[];
};

export const softoneObjectRegistry: Record<
  string,
  SoftOneObjectRegistryEntry
> = {
  ITEM: {
    object: "ITEM",
    description: "Είδη / Υπηρεσίες",
    webServiceMasterTable: "ITEM",
    physicalMasterTable: "MTRL",
    primaryKey: "MTRL",
    aliases: ["ΕΙΔΟΣ", "ΕΙΔΗ", "PRODUCT", "PRODUCTS"],
    notes: [
      "SoftOne Web Services object is ITEM.",
      "Cached object schema exposes master table ITEM.",
      "Known physical SQL master table is MTRL.",
    ],
  },

  CUSTOMER: {
    object: "CUSTOMER",
    description: "Πελάτες",
    physicalMasterTable: "TRDR",
    primaryKey: "TRDR",
    aliases: ["ΠΕΛΑΤΗΣ", "ΠΕΛΑΤΕΣ"],
  },

  SUPPLIER: {
    object: "SUPPLIER",
    description: "Προμηθευτές",
    physicalMasterTable: "TRDR",
    primaryKey: "TRDR",
    aliases: ["ΠΡΟΜΗΘΕΥΤΗΣ", "ΠΡΟΜΗΘΕΥΤΕΣ"],
  },

  SALDOC: {
    object: "SALDOC",
    description: "Παραστατικά πωλήσεων",
    physicalMasterTable: "FINDOC",
    primaryKey: "FINDOC",
    aliases: ["SALES DOCUMENT", "ΠΑΡΑΣΤΑΤΙΚΟ ΠΩΛΗΣΗΣ"],
  },

  PURDOC: {
    object: "PURDOC",
    description: "Παραστατικά αγορών",
    physicalMasterTable: "FINDOC",
    primaryKey: "FINDOC",
    aliases: ["PURCHASE DOCUMENT", "ΠΑΡΑΣΤΑΤΙΚΟ ΑΓΟΡΑΣ"],
  },

  RETAILDOC: {
    object: "RETAILDOC",
    description: "Παραστατικά λιανικής",
    physicalMasterTable: "FINDOC",
    primaryKey: "FINDOC",
  },

  ITEDOC: {
    object: "ITEDOC",
    description: "Παραστατικά ειδών",
    physicalMasterTable: "FINDOC",
    primaryKey: "FINDOC",
  },
};

export function normalizeSoftOneObjectName(
  value: string,
): string {
  const normalized = value.trim().toUpperCase();

  if (softoneObjectRegistry[normalized]) {
    return normalized;
  }

  for (const entry of Object.values(softoneObjectRegistry)) {
    if (
      entry.aliases?.some(
        alias => alias.trim().toUpperCase() === normalized,
      )
    ) {
      return entry.object;
    }
  }

  return normalized;
}

export function getSoftOneObjectRegistryEntry(
  value: string,
): SoftOneObjectRegistryEntry | null {
  const object =
    normalizeSoftOneObjectName(value);

  return softoneObjectRegistry[object] ?? null;
}
